   "raw": "uint8_t mb_read_C0nx(void *context, uint32_t addr) {\n    mb_cpu_data *mb_d = (mb_cpu_data *)context;\n    const uint8_t floating_bus = mb_d->computer->mmu->floating_bus_read();\n    mb_d->mockingboard->accessModeSwitch(addr);\n    return floating_bus;\n}\n",
