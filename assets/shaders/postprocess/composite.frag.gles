#version 300 es
precision mediump float;
precision highp int;

uniform highp sampler2D Processed;
uniform highp sampler2D UserInterface;

in highp vec2 vUV;
layout(location = 0) out highp vec4 FragColor;

void main()
{
    highp vec4 guest = texture(Processed, vUV);
    highp vec4 ui = texture(UserInterface, vUV);
    FragColor = vec4(ui.xyz + (guest.xyz * (1.0 - ui.w)), 1.0);
}
